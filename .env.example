# ─────────────────────────────────────────────────────────────────────────────
# TribalScholar AI — environment configuration
# Copy to `server/.env` for local development.
# For Vercel: Project Settings → Environment Variables (add every key below).
# ─────────────────────────────────────────────────────────────────────────────

# Port for the local Node server (ignored on Vercel — handled by the platform)
PORT=5000
NODE_ENV=development

# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017/tribal_scholar_ai
#   Vercel: use a MongoDB Atlas SRV string, e.g.
#           mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/tribal_scholar_ai
#           (Atlas Network Access must allow Vercel's outgoing IPs / 0.0.0.0/0)
MONGO_URI=mongodb://127.0.0.1:27017/tribal_scholar_ai

# REQUIRED in production. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_to_a_long_random_secret

# AI / OCR engines: "demo" (deterministic offline) or "live" (bring your provider key)
AI_MODE=demo
OCR_MODE=demo

# Comma-separated allow-list of browser origins allowed to call the API.
# Leave blank locally. On Vercel set it to your deployment URL, e.g.
#   CLIENT_URL=https://tribalscholar-ai.vercel.app
CLIENT_URL=http://localhost:5173

# Optional: override the upload directory.
# Not required on Vercel — serverless writes to an ephemeral /tmp path automatically.
# UPLOAD_DIR=./uploads
