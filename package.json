{
  "name": "tribal-scholar-ai",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "description": "TribalScholar AI — AI-enabled scholarship & fellowship management system for Scheduled Tribes (Ministry of Tribal Affairs, GoI).",
  "author": "Krishna R <vloggermr797@gmail.com>",
  "license": "MIT",
  "keywords": [
    "tribal-affairs",
    "scholarship",
    "fellowship",
    "mota",
    "scheduled-tribes",
    "dbt",
    "react",
    "express",
    "mongodb",
    "i18n",
    "ol-chiki"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KRISHNA0R/TribalScholarAI-Enabled-Scholarship-and-Fellowship-Management-System-for-Scheduled-Tribes..git"
  },
  "homepage": "https://github.com/KRISHNA0R/TribalScholarAI-Enabled-Scholarship-and-Fellowship-Management-System-for-Scheduled-Tribes",
  "bugs": {
    "url": "https://github.com/KRISHNA0R/TribalScholarAI-Enabled-Scholarship-and-Fellowship-Management-System-for-Scheduled-Tribes/issues"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n SERVER,CLIENT -c green,cyan \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/server.js",
    "seed": "node server/seed/seedRunner.js",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:integrity": "node scripts/verify-file-integrity.mjs",
    "verify": "npm run verify:integrity && npm run verify:i18n",
    "vercel-build": "npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
